



model Customer {
    id String @id @default(uuid()) @db.Uuid
    name String  @db.VarChar(100)
    email String  @unique  @db.VarChar(100)
    password String  
    role Role  
     bookings   Booking[]
    reviews    Review[]
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
     technicianProfile  TechnicianProfile?
}
